+/// Bind Web Host managed MCP calls to the current conversation. The bridge
+/// resolves its grant from the trusted scheduler run for this ID.
+fn scope_enterprise_mcp_url(server: &mut SessionMcpServer, conversation_id: &str) -> bool {
+    if !server.name.starts_with("rc2-enterprise-") {
+        return true;
+    }
+    let SessionMcpTransport::StreamableHttp { url, .. } = &mut server.transport else {
+        return true;
+    };
+    let Some(port) = url
+        .strip_prefix("http://model-gateway:")
+        .and_then(|tail| tail.strip_suffix("/mcp"))
+    else {
+        return true;
+    };
+    if port.parse::<u16>().ok().filter(|value| *value != 0).is_none() {
+        return true;
+    }
+    if conversation_id.is_empty()
+        || conversation_id.len() > 100
+        || !conversation_id
+            .chars()
+            .all(|ch| ch.is_ascii_alphanumeric() || matches!(ch, '-' | '_'))
+    {
+        return false;
+    }
+    *url = format!("http://model-gateway:{port}/conversations/{conversation_id}/mcp");
+    true
 }
 
