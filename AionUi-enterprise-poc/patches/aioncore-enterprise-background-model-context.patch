+
+fn scope_enterprise_mcp_urls(
+    servers: &mut HashMap<String, McpServerConfig>,
+    conversation_id: &str,
+) -> Result<(), AgentError> {
+    for (name, server) in servers {
+        if !name.starts_with("rc2-enterprise-") || server.transport != TransportType::StreamableHttp {
+            continue;
+        }
+        let Some(url) = server.url.as_deref() else { continue };
+        let Some(port) = url.strip_prefix("http://model-gateway:").and_then(|tail| tail.strip_suffix("/mcp")) else {
+            continue;
+        };
+        if port.parse::<u16>().ok().filter(|value| *value != 0).is_none() {
+            continue;
+        }
+        if conversation_id.is_empty()
+            || !conversation_id.chars().all(|ch| ch.is_ascii_alphanumeric() || matches!(ch, '-' | '_'))
+        {
+            return Err(AgentError::bad_request("Invalid enterprise conversation ID"));
+        }
+        server.url = Some(format!("http://model-gateway:{port}/conversations/{conversation_id}/mcp"));
+    }
+    Ok(())
 }
 
