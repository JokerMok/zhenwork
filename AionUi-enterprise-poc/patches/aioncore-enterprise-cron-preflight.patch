+async fn active_background_job(
+    State(state): State<CronRouterState>,
+    Extension(user): Extension<CurrentUser>,
+    headers: HeaderMap,
+    Path(job_id): Path<String>,
+) -> Result<Json<ApiResponse<serde_json::Value>>, ApiError> {
+    if headers.get("x-aionui-internal").and_then(|value| value.to_str().ok()) != Some("1") {
+        return Err(ApiError::Forbidden("internal route".into()));
+    }
+    Ok(Json(ApiResponse::ok(serde_json::json!({
+        "active": state.cron_service.is_background_job_active(&user.id, &job_id)
+    }))))
+}
