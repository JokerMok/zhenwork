+// Enterprise desktop mode keeps the upstream local identity model inside a
+// per-user database, but requires a separate capability at the loopback edge.
+// Runtime routes already validate their own conversation-scoped token.
+async fn enterprise_local_gate(State(expected): State<String>, request: Request, next: Next) -> Response {
+    let path = request.uri().path();
+    if request.method() == Method::OPTIONS
+        || path == "/health"
+        || path.starts_with("/api/runtime/")
+        || path.starts_with("/internal/antigravity-hook/")
+    {
+        return next.run(request).await;
+    }
+    let supplied = request
