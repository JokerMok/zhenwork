+    #[test]
+    fn row_to_response_hides_runtime_mcp_credentials_without_mutating_storage() {
+        let extra = serde_json::json!({
+            "workspace": "/tmp/example",
+            "team_mcp_stdio_config": { "port": 4123, "token": "team-private-token" },
+            "session_mcp_servers": [{ "name": "private", "transport": {
+                "type": "http", "url": "https://example.test/mcp", "headers": { "Authorization": "Bearer private" }
+            } }],
+            "mcp_servers": ["private"],
+            "mcp_server_ids": ["server-1"]
+        });
+        let row = make_row("aionrs", "finished", None, None, &extra.to_string());
+        let persisted = row.extra.clone();
+        let response = row_to_response(row, Path::new("/tmp/data")).unwrap();
+        assert!(response.extra.get("team_mcp_stdio_config").is_none());
+        assert!(response.extra.get("session_mcp_servers").is_none());
+        assert_eq!(response.extra["mcp_servers"], serde_json::json!(["private"]));
+        assert_eq!(response.extra["mcp_server_ids"], serde_json::json!(["server-1"]));
+        assert!(persisted.contains("team-private-token"));
+        assert!(persisted.contains("Bearer private"));
+    }
