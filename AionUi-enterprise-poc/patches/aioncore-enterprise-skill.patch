+fn enterprise_model_abort_target(
+    base_url: Option<&str>,
+    api_key: &str,
+    conversation_id: &str,
+    enterprise_worker: bool,
+) -> Option<(String, String)> {
+    if !enterprise_worker || api_key.is_empty() {
+        return None;
+    }
+    let mut url = reqwest::Url::parse(base_url?).ok()?;
+    if url.scheme() != "http"
+        || !matches!(url.host_str(), Some("127.0.0.1" | "model-gateway"))
+        || url.port().is_none()
+        || !url.username().is_empty()
+        || url.password().is_some()
+        || url.query().is_some()
+        || url.fragment().is_some()
+        || url.path() != format!("/conversations/{conversation_id}")
+    {
+        return None;
+    }
+    url.set_path(&format!("/conversations/{conversation_id}/cancel"));
+    Some((url.to_string(), api_key.to_owned()))
+}
+
