+        );
+        assert_eq!(expected, Some(("http://model-gateway:32124/conversations/a1b2c3d4/cancel".into(), "capability".into())));
+        for candidate in [
+            "http://model-gateway:32124/conversations/other",
+            "http://example.com:32124/conversations/a1b2c3d4",
+            "https://model-gateway:32124/conversations/a1b2c3d4",
+            "http://model-gateway:32124/conversations/a1b2c3d4?leak=1",
+        ] {
+            assert!(enterprise_model_abort_target(Some(candidate), "capability", "a1b2c3d4", true).is_none());
+        }
+        assert!(enterprise_model_abort_target(Some("http://127.0.0.1:32124/conversations/a1b2c3d4"),
+            "capability", "a1b2c3d4", false).is_none());
+    }
+}
