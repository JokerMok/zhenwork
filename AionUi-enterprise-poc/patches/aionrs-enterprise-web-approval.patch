+const WEB_DOCX_READER: &str = "/opt/aionui/tools/read_docx.py";
+
+/// The enterprise Web Core is an isolated, read-only image with a single
+/// employee profile bind mount. Only these exact inspection operations skip a
+/// permission card; a general shell command still requires approval.
+fn enterprise_web_auto_approved(name: &str, input: &serde_json::Value) -> bool {
+    if std::env::var("AION_ENTERPRISE_WEB_CORE").ok().as_deref() != Some("1") {
+        return false;
+    }
+    let Some(profile) = std::env::var_os("AION_ENTERPRISE_PROFILE_DIR") else {
+        return false;
+    };
+    is_low_risk_web_tool(name, input, Path::new(&profile), WEB_DOCX_READER)
+}
+
+fn is_low_risk_web_tool(name: &str, input: &serde_json::Value, profile: &Path, reader: &str) -> bool {
+    if name == "ToolSearch" {
+        return true;
+    }
+    if name != "ExecCommand" || input.get("shell").is_some_and(|shell| shell != "auto") {
+        return false;
+    }
+    let Some(command) = input.get("cmd").and_then(serde_json::Value::as_str) else {
+        return false;
+    };
+    if command.len() > 4096 {
+        return false;
+    }
+    let Some(redirections) = simple_shell_redirections(command) else {
+        return false;
+    };
+    let Some(tokens) = shlex::split(command) else {
+        return false;
+    };
+    let words: Vec<&str> = tokens.iter().map(String::as_str).collect();
+    match words.as_slice() {
+        ["command", "-v", "officecli"] | ["officecli", "--version"] => redirections == 0,
+        ["officecli", "help", args @ ..] => {
+            redirections == 0
+                && args.len() <= 4
+                && args
+                    .iter()
+                    .all(|arg| !arg.is_empty() && arg.bytes().all(|byte| byte.is_ascii_alphanumeric() || byte == b'-'))
+        }
+        ["officecli", "view", file, mode]
+            if matches!(*mode, "text" | "outline" | "stats" | "issues" | "annotated" | "html") =>
+        {
+            redirections == 0 && profile_document(file, profile)
+        }
+        ["officecli", "validate", file] | ["officecli", "validate", file, "--json"] => {
+            redirections == 0 && profile_document(file, profile)
+        }
+        ["officecli", "get", file, selector] | ["officecli", "query", file, selector] => {
+            redirections == 0 && !selector.is_empty() && profile_document(file, profile)
+        }
+        ["python3", "-I", script, file] if *script == reader => {
+            redirections == 0 && profile_document(file, profile) && file.ends_with(".docx")
+        }
+        ["python3", "-I", script, file, ">", output] if *script == reader => {
+            redirections == 1 && profile_document(file, profile) && file.ends_with(".docx") && safe_temp_output(output)
+        }
+        _ => false,
+    }
+}
+
+fn profile_document(file: &str, profile: &Path) -> bool {
+    let path = Path::new(file);
+    if !matches!(
+        path.extension().and_then(|ext| ext.to_str()),
+        Some("docx" | "xlsx" | "pptx")
+    ) {
+        return false;
+    }
+    let (Ok(root), Ok(document)) = (profile.canonicalize(), path.canonicalize()) else {
+        return false;
+    };
+    document.starts_with(root) && document.is_file()
+}
+
+fn safe_temp_output(output: &str) -> bool {
+    let Some(name) = output.strip_prefix("/tmp/") else {
+        return false;
+    };
+    !name.is_empty()
+        && name.len() <= 80
+        && name != "."
+        && name != ".."
+        && name
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'.' | b'_' | b'-'))
+}
+
+/// Reject expansion, pipelines, chained commands and shell control syntax.
+/// One spaced stdout redirection is permitted for the pinned document reader.
+fn simple_shell_redirections(command: &str) -> Option<usize> {
+    let chars: Vec<char> = command.chars().collect();
+    let mut quote = None;
+    let mut redirects = 0;
+    for (index, character) in chars.iter().enumerate() {
+        match quote {
+            Some('\'') => {
+                if *character == '\'' {
+                    quote = None;
+                }
+            }
+            Some('"') => {
+                if *character == '"' {
+                    quote = None;
+                } else if matches!(*character, '$' | '`' | '\\' | '\n' | '\r') {
+                    return None;
+                }
+            }
+            _ => match *character {
+                '\'' | '"' => quote = Some(*character),
+                '>' if index > 0
+                    && index + 1 < chars.len()
+                    && chars[index - 1].is_whitespace()
+                    && chars[index + 1].is_whitespace() =>
+                {
+                    redirects += 1;
+                    if redirects > 1 {
+                        return None;
+                    }
+                }
+                '$' | '`' | '\\' | ';' | '|' | '&' | '<' | '>' | '(' | ')' | '{' | '}' | '#' | '*' | '?' | '['
+                | ']' | '\n' | '\r' => return None,
+                _ => {}
+            },
+        }
+    }
+    quote.is_none().then_some(redirects)
+}
