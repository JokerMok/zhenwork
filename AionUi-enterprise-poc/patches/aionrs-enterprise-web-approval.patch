@@ -5,6 +5,81 @@ mod tests {
     use super::*;
     use serde_json::json;
 
+    #[test]
+    fn enterprise_web_document_inspection_skips_only_low_risk_approvals() {
+        let profile = tempfile::tempdir().unwrap();
+        let document = profile.path().join("招标文件 最终版(2).docx");
+        std::fs::write(&document, b"sample").unwrap();
+        let file = document.to_str().unwrap();
+
+        assert!(is_low_risk_web_tool(
+            "ToolSearch",
+            &json!({"query": "officecli"}),
+            profile.path(),
+            WEB_DOCX_READER
+        ));
+        assert!(is_low_risk_web_tool(
+            "ExecCommand",
+            &json!({"cmd": "command -v officecli"}),
+            profile.path(),
+            WEB_DOCX_READER
+        ));
+        assert!(is_low_risk_web_tool(
+            "ExecCommand",
+            &json!({"cmd": format!("officecli view '{file}' text")}),
+            profile.path(),
+            WEB_DOCX_READER
+        ));
+        assert!(is_low_risk_web_tool(
+            "ExecCommand",
+            &json!({"cmd": format!("python3 -I {WEB_DOCX_READER} '{file}' > /tmp/document.txt")}),
+            profile.path(),
+            WEB_DOCX_READER
+        ));
+        assert!(!is_low_risk_web_tool(
+            "ExecCommand",
+            &json!({"cmd": format!("python3 {WEB_DOCX_READER} '{file}'")}),
+            profile.path(),
+            WEB_DOCX_READER
+        ));
+        assert!(!is_low_risk_web_tool(
+            "ExecCommand",
+            &json!({"cmd": format!("officecli view '{file}' text && rm -rf /tmp")}),
+            profile.path(),
+            WEB_DOCX_READER
+        ));
+        assert!(!is_low_risk_web_tool(
+            "ExecCommand",
+            &json!({"cmd": format!("officecli view \"$(touch /tmp/probe)\" text")}),
+            profile.path(),
+            WEB_DOCX_READER
+        ));
+        assert!(!is_low_risk_web_tool(
+            "ExecCommand",
+            &json!({"cmd": format!("officecli view '{file}' text"), "shell": "/tmp/evil-shell"}),
+            profile.path(),
+            WEB_DOCX_READER
+        ));
+        assert!(!is_low_risk_web_tool(
+            "ExecCommand",
+            &json!({"cmd": format!("python3 -I {WEB_DOCX_READER} '{file}' > /etc/passwd")}),
+            profile.path(),
+            WEB_DOCX_READER
+        ));
+        assert!(!is_low_risk_web_tool(
+            "ExecCommand",
+            &json!({"cmd": "officecli create /tmp/new.docx"}),
+            profile.path(),
+            WEB_DOCX_READER
+        ));
+        assert!(!is_low_risk_web_tool(
+            "Write",
+            &json!({}),
+            profile.path(),
+            WEB_DOCX_READER
+        ));
+    }
