# Build from the already patched upstream-core checkout. The release pipeline
# must run scripts/setup-enterprise-core.sh before constructing this image.
FROM rust:1.95.0-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1 AS build
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src/upstream-core
COPY upstream-core/ ./
COPY upstream-aionrs/ ../upstream-aionrs/
RUN RUSTUP_TOOLCHAIN=1.95.0 cargo build --release --locked -p aionui-app --bin aioncore
RUN mkdir -p /bundle /tmp/aionui-build-data && cp target/release/aioncore /bundle/aioncore \
    && /bundle/aioncore --data-dir /tmp/aionui-build-data prepare-managed-resources --bundle-out /bundle/managed-resources

FROM node:24.11.0-bookworm-slim@sha256:76d0ed0ed93bed4f4376211e9d8fddac4d8b3fbdb54cc45955696001a3c91152 AS node-runtime
RUN npm install --global --omit=dev \
    tsx@4.23.15 beautiful-mermaid@1.1.3 \
    png-chunks-extract@1.0.0 png-chunk-text@1.0.0 canvas@3.2.3
FROM ghcr.io/astral-sh/uv:0.12.22@sha256:f513a91fc62fe7c17567eee97230dd198e43edb8a9fbecca843714a4358fe1bc AS uv-runtime

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    ca-certificates libssl3 libstdc++6 python3 python3-venv python3-pip git curl ripgrep unzip jq \
    poppler-utils qpdf tesseract-ocr tesseract-ocr-eng tesseract-ocr-chi-sim \
    libcairo2 libpango-1.0-0 libjpeg62-turbo libgif7 librsvg2-2 libexpat1 fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/aionui && chown 10001:10001 /home/aionui
COPY --from=build /bundle /opt/aionui/core
COPY upstream-core/crates/aionui-app/assets/builtin-skills/auto-inject/officecli/scripts/read_docx.py /opt/aionui/tools/read_docx.py
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=uv-runtime /uv /uvx /usr/local/bin/
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -s ../lib/node_modules/tsx/dist/cli.mjs /usr/local/bin/tsx \
    && uv venv --python /usr/bin/python3 /opt/aionui/skill-python \
    && uv pip install --python /opt/aionui/skill-python/bin/python \
       pypdf==6.19.0 pdfplumber==0.11.10 reportlab==5.0.1 \
       pdf2image==1.17.0 pillow==12.3.0 pytesseract==0.3.13 pypdfium2==5.14.0 \
    && node --version && npm --version && python3 --version && uv --version && uvx --version
ARG OFFICECLI_VERSION=1.0.152
COPY packages/web-host/docker/officecli-license/ /usr/share/doc/officecli/
RUN case "$(dpkg --print-architecture)" in \
      arm64) officecli_asset=officecli-linux-arm64; officecli_sha=bc06deaa0ad931f5208717a40b94018dc44cdff0d8eefa842c4f4daf89fb35a8 ;; \
      amd64) officecli_asset=officecli-linux-x64; officecli_sha=e54d3c1d248372365f0634aac56d6f1918bd04d6e71afc792ad50e075f56cfe9 ;; \
      *) echo 'Unsupported OfficeCLI architecture' >&2; exit 1 ;; \
    esac \
    && (if [ -s /tmp/officecli ]; then \
          :; \
        else \
          curl -fsSL --retry 5 --retry-delay 2 \
            "https://d.officecli.ai/releases/download/v${OFFICECLI_VERSION}/${officecli_asset}" \
            -o /tmp/officecli \
          || curl -fsSL --retry 5 --retry-delay 2 \
            "https://github.com/iOfficeAI/OfficeCLI/releases/download/v${OFFICECLI_VERSION}/${officecli_asset}" \
            -o /tmp/officecli; \
        fi) \
    && echo "${officecli_sha}  /tmp/officecli" | sha256sum -c - \
    && install -m 0755 /tmp/officecli /usr/local/bin/officecli \
    && rm /tmp/officecli \
    && officecli --version
ENV HOME=/home/aionui \
    PATH=/opt/aionui/skill-python/bin:${PATH} \
    PYTHONPATH=/opt/aionui/skill-python/lib/python3.11/site-packages \
    NODE_PATH=/usr/local/lib/node_modules
USER 10001:10001
WORKDIR /home/aionui
ENTRYPOINT ["/opt/aionui/core/aioncore"]
