# Copy to an owner-only file; no model credentials belong here or in this bundle.
ZW_ROOT=/opt/zhenwork
ZW_INSTANCE=enterprise
ZW_PRODUCT_NAME=ZhenWork
ZW_COMPANY_NAME=企业名称
ZW_ADMIN_USERNAME=enterprise-admin
ZW_EMPLOYEE_ORIGIN=https://work.example.com
ZW_ADMIN_ORIGIN=https://admin.example.com
ZW_TLS_MODE=acme
ZW_BIND_ADDRESS=0.0.0.0
ZW_PORT_BASE=18880
ZW_CAPACITY=small
ZW_MAX_CORES=2
ZW_MAX_STARTING_CORES=1
ZW_MAX_QUEUED_CORE_STARTS=8
ZW_CORE_IDLE_MS=30000
ZW_CORE_START_WAIT_MS=300000
ZW_MAX_SESSIONS=50
ZW_BACKUP_KEY_FILE=/root/zhenwork-backup.key
# Optional preloaded, verified image cache; otherwise build using the supplied runtime recipe.
ZW_IMAGE_LOCK=
